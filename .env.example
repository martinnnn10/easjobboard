# EAS Recruit — environment variables
# Copy to .env.local (dev) or set in the process environment / PM2 (prod).
# .env* is gitignored; never commit real secrets.

# ── Required ────────────────────────────────────────────────────────────────
# Session signing secret (HMAC-SHA256). The app AND the production proxy require
# this — without it, login/session verification throws. Use a long random value
# (e.g. `openssl rand -hex 32`). MUST be identical for the app and the proxy.
AUTH_SECRET=

# ── Email / SMTP (required for outbound email to actually send) ──────────────
# When unset, the app runs but every email is skipped/logged (see DEPLOYMENT.md
# "Email delivery"). Applications are still stored and downloadable.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
# From: header (defaults: FROM_EMAIL=SMTP_USER, FROM_NAME=PLATFORM_NAME)
FROM_EMAIL=
FROM_NAME=

# ── Public / canonical URLs ─────────────────────────────────────────────────
# Internal admin navigation base (default http://localhost:3000).
BASE_URL=
# Public, shareable HTTPS origin for careers/job pages, JSON-LD, sitemap, feeds,
# flyers, QR. A localhost/raw-IP/dot-less value is ignored and falls back to the
# canonical production domain, so public pages never leak localhost or an IP.
PUBLIC_BASE_URL=

# ── Platform branding ───────────────────────────────────────────────────────
PLATFORM_NAME=EAS Recruit
PLATFORM_COMPANY=Electrical Automation Services Inc
PLATFORM_EMAIL=eas@eautomatedstaffing.com

# ── Stripe billing (optional; used by the production proxy paywall) ──────────
# Absent keys ⇒ billing runs in "not configured" mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SEAT_PRICE_USD=99
STRIPE_TRIAL_DAYS=14

# ── Optional AI / sourcing (each feature falls back to offline when unset) ───
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
APOLLO_API_KEY=

# ── Runtime / ops ───────────────────────────────────────────────────────────
PORT=3030
HOSTNAME=0.0.0.0
# Surfaced by /api/health for deploy traceability (optional; set at deploy time).
APP_VERSION=
GIT_COMMIT=
